#!/bin/bash
set -euo pipefail

# script/ci-promote <patch|minor|major> — the CI `promote` job's body, run
# after the hold is approved. Promotes the dev:<sha> orb that this pipeline's
# `publish` job pushed, via `rake promote:<bump>[<sha>]`. The Rakefile's
# CHANGELOG gate runs first. script/ci-promote-gate chose the bump.

: "${CIRCLE_SHA1:?CIRCLE_SHA1 is not set; refusing to guess which dev label to promote}"

bump="${1:-}"
case "$bump" in
  patch | minor | major) ;;
  *)
    echo "usage: script/ci-promote <patch|minor|major> (got '${bump}')" >&2
    exit 1
    ;;
esac

exec rake "promote:${bump}[${CIRCLE_SHA1}]"
